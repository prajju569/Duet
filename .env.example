# ── Supabase ─────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" / "publishable" key (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ── YouTube ──────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → API key
# (with "YouTube Data API v3" enabled). Only used on the server by
# /api/search, so it never ships to the browser.
NEXT_PUBLIC_YT_API_KEY=your-youtube-data-api-key

# ── PIN login ────────────────────────────────────────────────────────
# Server-only secret that scrambles PINs. Any 32+ random characters.
# Set it BEFORE anyone creates a PIN — changing it later resets every PIN.
# (If missing, SUPABASE_JWT_SECRET from the Vercel↔Supabase integration is used.)
PIN_PEPPER=

# ── Invite links ─────────────────────────────────────────────────────
# Supabase → Project Settings → API → service_role (secret) key. SERVER ONLY —
# never prefix with NEXT_PUBLIC_. Used only to create an account for someone who
# taps an invite link. (The Vercel↔Supabase integration adds this automatically.)
SUPABASE_SERVICE_ROLE_KEY=

# ── Push notifications (optional) ────────────────────────────────────
# Generate once with:  npx web-push generate-vapid-keys
# Changing them later means everyone has to turn notifications on again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
